// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "buffer_line_height": "standard",
  "minimum_contrast_for_highlights": 0,
  "diagnostics_max_severity": "off",
  "inline_code_actions": false,
  "audio": {
    "experimental.auto_speaker_volume": false,
  },
  "gutter": {
    "runnables": false,
  },
  "diagnostics": {
    "include_warnings": false,
    "button": true,
  },
  "terminal": {
    "button": true,
    "env": {
      "GIT_EDITOR": "zed --wait",
    },
  },
  "zoomed_padding": true,
  "seed_search_query_from_cursor": "never",
  "show_wrap_guides": false,
  "confirm_quit": false,
  "selection_highlight": false,
  "rounded_selection": true,
  "current_line_highlight": "none",
  "agent_buffer_font_size": 14.0,
  "use_system_path_prompts": false,
  "use_system_prompts": false,
  "active_pane_modifiers": {
    "border_size": 0.3,
    "inactive_opacity": 0.85,
  },
  "on_last_window_closed": "quit_app",
  "restore_on_startup": "launchpad",
  "format_on_save": "on",
  "toolbar": {
    "breadcrumbs": true,
    "agent_review": false,
    "selections_menu": false,
    "quick_actions": false,
  },
  "outline_panel": {
    "dock": "left",
    "button": true,
    "file_icons": false,
  },
  "linked_edits": false,
  "inlay_hints": {
    "enabled": false,
  },
  "show_completion_documentation": false,
  "show_whitespaces": "trailing",
  "show_edit_predictions": false,
  "jsx_tag_auto_close": {
    "enabled": false,
  },
  "use_autoclose": false,
  "buffer_font_weight": 400.0,
  "show_completions_on_input": false,
  "use_auto_surround": false,
  "tabs": {
    "show_diagnostics": "all",
    "file_icons": false,
    "git_status": false,
  },
  "tab_bar": {
    "show_tab_bar_buttons": false,
    "show_nav_history_buttons": false,
    "show": true,
  },
  "project_panel": {
    "sticky_scroll": false,
    "show_diagnostics": "all",
    "button": true,
    "starts_open": false,
    "folder_icons": true,
    "file_icons": false,
    "dock": "left",
  },
  "notification_panel": {
    "button": false,
    "dock": "left",
  },
  "indent_guides": {
    "active_line_width": 2,
    "line_width": 1,
    "enabled": false,
    "background_coloring": "disabled",
    "coloring": "disabled",
  },
  "scroll_beyond_last_line": "one_page",
  "file_finder": {
    "file_icons": false,
    "modal_max_width": "medium",
  },
  "git_panel": {
    "status_style": "icon",
    "dock": "right",
  },
  "cursor_shape": "bar",
  "agent_ui_font_size": 14.0,
  "preview_tabs": {
    "enabled": true,
    "enable_preview_from_file_finder": false,
  },
  "title_bar": {
    "show_branch_status_icon": true,
    "show_project_items": true,
    "show_user_picture": false,
    "show_branch_name": true,
    "show_menus": false,
    "show_sign_in": false,
  },
  "search": {
    "case_sensitive": true,
    "regex": true,
    "button": true,
  },
  "status_bar": {
    "active_language_button": true,
    "cursor_position_button": true,
  },
  "collaboration_panel": {
    "dock": "left",
    "button": false,
  },
  "git": {
    "git_gutter": "hide",
    "branch_picker": {
      "show_author_name": false,
    },
    "blame": {
      "show_avatar": false,
    },
    "inline_blame": {
      "enabled": false,
    },
  },
  "relative_line_numbers": "enabled",
  "scrollbar": {
    "diagnostics": "none",
    "show": "never",
  },
  "journal": {
    "hour_format": "hour24",
  },

  // Ai
  "disable_ai": true,
  "agent": {
    "dock": "right",
    "button": false,
    "expand_terminal_card": false,
    "expand_edit_card": false,
    "enable_feedback": false,
    "single_file_review": false,
    "model_parameters": [],
  },

  // Language Specific Settings
  "languages": {
    "Rust": {},
    "C": {},
    "C++": {},
    "Zig": {},
    "Python": {
      "language_servers": [
        "ty",
        "ruff",
        "!basedpyright",
        "!pyrefly",
        "!pyright",
        "!pylsp",
      ],
    },
  },

  // LSP configs
  "lsp": {
    "clangd": {
      "binary": {
        "arguments": ["--compile-commands-dir=./build/clang/"],
      },
    },
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "clippy",
          "workspace": false,
        },
        "cargo": { "allTargets": false },
      },
    },
    "ruff": {
      "initialization_options": {
        "settings": {
          "lint": {
            "select": ["E", "F", "I"],
          },
          "organizeImports": true,
        },
      },
    },
  },

  "completions": {
    "lsp": false,
  },
  "hide_mouse": "never",
  "ui_font_family": "Hack Nerd Font Mono",
  "buffer_font_family": "Hack Nerd Font Mono",
  "buffer_font_features": {
    "calt": false,
  },
  "auto_update": false,
  "base_keymap": "VSCode",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "vim_mode": true,
  "vim": {
    "use_system_clipboard": "always",
    "highlight_on_yank_duration": 1500,
    "cursor_shape": {
      "normal": "block",
      "insert": "bar",
      "replace": "underline",
      "visual": "block",
    },
  },
  "icon_theme": "Catppuccin Mocha",
  "ui_font_size": 14.0,
  "buffer_font_size": 15.0,
  "theme": "Kanso Zen (Borderless + No italics)",
  "file_scan_exclusions": [
    "**/moc_*.cpp",
    "**/moc_*.h",
    "**/moc_*.hpp",
    "**/.obj",
    "**/.o",
    "**/.ilk",
    "**/.so",
    "**/.dll",
    "**/.lib",
    "**/.swp",
    "**/.exe",
    "**/.zip",
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/build/release/",
    "**/build_native/",
    "**/build-*/",
    "**/build/",
    "**/.zig-cache/",
    "**/zig-out/",
    "**/target/release/",
    "**/target/debug/",
    "**/target",
    "**/venv",
    "**/.venv",
    "**/vendor",
    "**/tmp",
    "**/__pycache__",
    "**/out",
    "**/dist",
    "**/.husky",
    "**/.turbo",
    "**/.vscode-test",
    "**/.vscode",
    "**/.next",
    "**/.storybook",
    "**/.tap",
    "**/.nyc_output",
    "**/report",
    "**/node_modules",
  ],
  "auto_install_extensions": {
    "catppuccin-icons": true,
    "kanso": true,
  },
}
