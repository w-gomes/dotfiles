// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  // Clear out a few defaults
  {
    "bindings": {
      "alt-h": null,
      "ctrl-w": null,
      "ctrl-;": null,
      "f1": null,
      "f2": null,
      "f3": null,
      "f4": null,
      "f5": null,
      "f6": null,
      "f7": null,
      "f8": null,
      "f9": null,
      "f10": null,
      "f11": null,
      "f12": null,
    },
  },

  // Global leader key
  {
    "context": "(Workspace && !Editor && !Terminal) || (Editor && VimControl)",
    "bindings": {
      "space space": "tab_switcher::ToggleAll", // Works like :ls
      "space f f": "file_finder::Toggle",
      "space f n": "workspace::NewFile",

      // Splits panels right or down.
      "space m v": "pane::SplitAndMoveRight",
      "space m s": "pane::SplitAndMoveDown",

      // Clones a pane and move right or down.
      "space v": "pane::SplitRight",
      "space s": "pane::SplitDown",

      // Join panels
      "space j f": "pane::JoinIntoNext",
      "space j a": "pane::JoinAll",

      // :w and :wa
      "space w": "workspace::Save",
      "space w a": "workspace::SaveAll",
    },
  },

  // Window Navigations
  {
    "context": "ProjectPanel || (Workspace && !menu && !(Picker > Editor))",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",

      "f2": "workspace::ToggleLeftDock",
      "f3": "file_finder::Toggle",
    },
  },

  {
    "context": "EmptyPane || SharedScreen",
    "bindings": {
      "f1": "projects::OpenRecent",
      "f2": "workspace::ToggleLeftDock",
      "f3": "file_finder::Toggle",
    },
  },

  // Vim Editor
  {
    "context": "Editor && VimControl && !menu",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",

      "ctrl-shift-h": "workspace::MovePaneLeft",
      "ctrl-shift-l": "workspace::MovePaneRight",
      "ctrl-shift-k": "workspace::MovePaneUp",
      "ctrl-shift-j": "workspace::MovePaneDown",

      "shift-h": "pane::ActivatePreviousItem",
      "shift-l": "pane::ActivateNextItem",

      "f2": "workspace::ToggleLeftDock",
      "f3": "file_finder::Toggle",
      "f4": "tab_switcher::ToggleAll",
      "f5": "pane::ActivatePreviousItem",
      "f6": "pane::ActivateNextItem",
    },
  },

  {
    "context": "(vim_mode == normal || vim_mode == visual) && !VimCount",
    "bindings": {
      "s": "vim::PushSneak",
      "shift-s": "vim::PushSneakBackward",
    },
  },

  {
    "context": "vim_operator == a || vim_operator == i || vim_operator == cs",
    "bindings": {
      // Traditional vim
      "Q": "vim::AnyQuotes",
      "B": "vim::AnyBrackets",

      // Mini.ai
      "q": "vim::MiniQuotes",
      "b": "vim::MiniBrackets",
    },
  },

  {
    "context": "vim_mode == visual",
    "bindings": {
      "v": "editor::SelectLargerSyntaxNode",
      "V": "editor::SelectSmallerSyntaxNode",
    },
  },

  {
    "context": "vim_mode == insert",
    "bindings": {
      "j k": "vim::NormalBefore",
      "k j": "vim::NormalBefore",
    },
  },
]
