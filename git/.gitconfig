[core]
    editor = "vim"
[alias]
    st = status --short
    sts = status
    ap = add --patch
    up = add --update
    track = add -N
    cv = commit --verbose
    cm = commit -m
    sw = switch
    df = diff
    dfh = diff HEAD
    dfsg = diff --staged
    dfst = diff --stat
    lp = log -p
    ls = log --pretty=oneline
    lg = log --graph
[pull]
    ff = only
